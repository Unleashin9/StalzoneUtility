/* ========================================================= */
/* === ПАЛИТРА "РЖАВАЯ ЗОНА" ===                             */
/* ========================================================= */
/*   ФОН:           #181411 (тёплый графит)                  */
/*                  #1F1A16 (панели top/bottom)              */
/*                  #221C18 (кнопки/поля)                    */
/*   АКЦЕНТ:        #F0A93B (янтарный / ржавчина)            */
/*                  #F5BD6A (hover)                          */
/*                  #D6932F (pressed)                        */
/*   ТЕКСТ:         #F5E6D3 (акцентный / кремовый)          */
/*                  #A8998A (обычный / пыльный)              */
/*   РАМКИ:         #3A2F26                                  */
/*   ОПАСНОСТЬ:     #E5533D / #F07662 / #CC4730             */
/* ========================================================= */

/* ========================================================= */
/* === 1. ГЛОБАЛЬНЫЕ НАСТРОЙКИ ===                           */
/* ========================================================= */

/* Принудительная прозрачность для всех кастомных окон, чтобы не было темных углов */
QDialog, 
#loginDialog, 
#registerDialog, 
#requirementsPanel {
    background: transparent;
    background-color: transparent;
}

QWidget {
    background-color: #181411;
    color: #A8998A;
    font-family: "IBM Plex Sans", "Segoe UI", Arial, sans-serif;
    font-size: 14px;
}

QLabel {
    background-color: transparent;
}

QMainWindow, QDialog {
    background-color: transparent;
}

QPushButton {
    background-color: @accent@;
    color: #181411;
    border: none;
    border-radius: 8px;
    padding: 0px 16px;
    font-weight: bold;
}
QPushButton:hover    { background-color: #F5BD6A; }
QPushButton:pressed  { background-color: #D6932F; }
QPushButton:disabled {
    background-color: #3A2F26;
    color: #A8998A;
}

/* ========================================================= */
/* === 2. MAINWINDOW ===                                     */
/* ========================================================= */

#mainContainer {
    background-color: #181411;
    border: none;
    border-radius: 0px;
}

#topBar {
    background-color: #1F1A16;
    border: none;
    border-bottom: 1px solid #3A2F26;
    border-radius: 0;
}

#logoBtn {
    background: transparent;
    background-color: transparent;
    color: #F5E6D3;
    border: none;
    outline: none;
    border-radius: 0;
    font-size: 40px;
    font-weight: bold;
    text-align: left;
    padding: 0px 10px 0px 10px;
    min-height: 60px;
}
#logoBtn:hover,
#logoBtn:pressed,
#logoBtn:focus,
#logoBtn:default {
    background: transparent;
    background-color: transparent;
    color: #F5E6D3;
    border: none;
    outline: none;
}

#btnLogin {
    background-color: @accent@;
    color: #181411;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: bold;
    text-align: center;
    padding-left: 15px;
    padding-right: 15px;
}
#btnLogin:hover   { background-color: #F5BD6A; }
#btnLogin:pressed { background-color: #D6932F; }

QToolButton#btnExit, QToolButton#btnDiscord {
    border: none;
    border-radius: 8px;
    padding: 0px;
}
QToolButton#btnExit {
    background-color: #E5533D;
}
QToolButton#btnExit:hover   { background-color: #F07662; }
QToolButton#btnExit:pressed { background-color: #CC4730; }

QToolButton#btnDiscord {
    background-color: #5865F2;
}
QToolButton#btnDiscord:hover   { background-color: #7983F5; }
QToolButton#btnDiscord:pressed { background-color: #4752C4; }

/* ========================================================= */
/* === 3. ДИАЛОГИ АВТОРИЗАЦИИ (LOGIN / REGISTER) ===         */
/* ========================================================= */

#dialogContainer {
    background-color: #1F1A16;
    border-radius: 15px;
    border: 1px solid #3A2F26;
}

#dialogContainer #loginTitle {
    font-size: 24px;
    font-weight: bold;
    color: #F5E6D3;
}
#dialogContainer #loginSubtitle {
    font-size: 14px;
    color: #A8998A;
}

#dialogContainer #inputLabel {
    font-size: 12px;
    font-weight: bold;
    color: #A8998A;
}

#dialogContainer #dividerLine {
    color: #3A2F26;
    background-color: #3A2F26;
    max-height: 1px;
    border: none;
    margin-top: 5px;
    margin-bottom: 5px;
}

#dialogContainer #linkButton {
    background-color: transparent;
    color: @accent@;
    font-size: 12px;
    font-weight: normal;
    border: none;
    padding: 0px;
    text-align: right;
}
#dialogContainer #linkButton:hover {
    color: #F5BD6A;
    text-decoration: underline;
}

#dialogContainer #loginSubmitBtn {
    background-color: @accent@;
    color: #181411;
    font-weight: bold;
    font-size: 16px;
    border-radius: 8px;
}
#dialogContainer #loginSubmitBtn:hover   { background-color: #F5BD6A; }
#dialogContainer #loginSubmitBtn:pressed { background-color: #D6932F; }

#dialogContainer #outlineButton {
    background-color: transparent;
    border: 1px solid @accent@;
    color: @accent@;
    border-radius: 6px;
    padding: 4px 15px;
    font-weight: bold;
    font-size: 12px;
}
#dialogContainer #outlineButton:hover   { background-color: rgba(240, 169, 59, 0.1); }
#dialogContainer #outlineButton:pressed { background-color: rgba(240, 169, 59, 0.2); }

#dialogContainer QLineEdit {
    background-color: #221C18;
    color: #F5E6D3;
    border: 1px solid #3A2F26;
    border-radius: 6px;
    padding: 8px;
}
#dialogContainer QLineEdit:focus {
    border: 1px solid @accent@;
}

#dialogContainer QLineEdit QToolButton {
    background-color: transparent;
    border: none;
    padding: 0px;
    margin: 0px 5px 0px 0px;
}
#dialogContainer QLineEdit QToolButton:hover {
    background-color: rgba(245, 230, 211, 0.08);
    border-radius: 4px;
}

#dialogContainer QCheckBox {
    background: transparent;
    background-color: transparent;
    color: #A8998A;
    font-size: 13px;
    spacing: 8px;
}
#dialogContainer QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #3A2F26;
    border-radius: 4px;
    background-color: #221C18;
}
#dialogContainer QCheckBox::indicator:hover {
    border: 1px solid @accent@;
}
#dialogContainer QCheckBox::indicator:checked {
    background-color: #221C18;
    border: 1px solid @accent@;
    image: url("@rememberMeIcon@");
}

/* ========================================================= */
/* === 4. ОБЩИЕ ЭЛЕМЕНТЫ ===                                 */
/* ========================================================= */

#auctionRoot, #barterRoot, #itemsRoot {
    background-color: #181411;
}

QPushButton#btnBack {
    background-color: transparent;
    color: #A8998A;
    border: none;
    font-size: 16px;
    font-weight: normal;
    text-align: left;
    padding: 5px;
}
QPushButton#btnBack:hover {
    color: @accent@;
}

QTableWidget {
    background-color: #181411;
    alternate-background-color: #1F1A16;
    gridline-color: transparent;
    border: none;
    border-radius: 0;
    selection-background-color: rgba(240, 169, 59, 0.25);
    selection-color: #F5E6D3;
    outline: none;
}
QTableWidget::item {
    padding: 6px 10px;
    border: none;
}

QHeaderView::section {
    background-color: #1F1A16;
    color: #A8998A;
    font-size: 12px;
    font-weight: bold;
    padding: 8px 10px;
    border: none;
    border-bottom: 1px solid #3A2F26;
}

QComboBox, QLineEdit {
    background-color: #221C18;
    color: #F5E6D3;
    border: 1px solid #3A2F26;
    border-radius: 6px;
    padding: 8px 12px;
    min-width: 150px;
}
QComboBox:focus, QLineEdit:focus {
    border: 1px solid @accent@;
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #3A2F26;
    border-radius: 5px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: @accent@;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

/* ========================================================= */
/* === 5. УВЕДОМЛЕНИЯ (TOAST) ===                            */
/* ========================================================= */

#toastError {
    background-color: #1F1A16;
    color: #E5533D;          /* Кирпично-красный */
    border: 1px solid #E5533D;
    border-radius: 8px;
    padding: 12px 24px;
    font-weight: bold;
    font-size: 13px;
}

#toastSuccess {
    background-color: #1F1A16;
    color: @accent@;         /* Янтарный (берется из ThemeManager) */
    border: 1px solid @accent@;
    border-radius: 8px;
    padding: 12px 24px;
    font-weight: bold;
    font-size: 13px;
}

/* ========================================================= */
/* === 6. ПАНЕЛЬ ТРЕБОВАНИЙ ===                              */
/* ========================================================= */

#requirementsContainer {
    background-color: #1F1A16;
    border: 1px solid #3A2F26;
    border-radius: 12px;
}

#rulesTitle {
    color: #F5E6D3;
    font-size: 13px;
    font-weight: bold;
}

/* ========================================================= */
/* === 7. МЕНЮ ПРОФИЛЯ ===                                   */
/* ========================================================= */

#profileMenu {
    background-color: #1F1A16;
    border: 1px solid #3A2F26;
    border-radius: 10px;
}

#profileMenuItem {
    background-color: transparent;
    color: #A8998A;
    border: none;
    border-radius: 6px;
    text-align: left;
    padding: 0px 14px;
    font-size: 13px;
    font-weight: normal;
}
#profileMenuItem:hover {
    background-color: #221C18;
    color: @accent@;
}
#profileMenuItem:pressed {
    background-color: #181411;
}

/* ========================================================= */
/* === 9. SETTINGS WINDOW ===                                */
/* ========================================================= */

#settingsRoot {
    background-color: #181411; /* Или твой цвет основного фона */
}

/* ========================================================= */
/* === 10. SETTINGS WINDOW (BOTTOM BAR) ===                  */
/* ========================================================= */

#bottomBar {
    background-color: #1F1A16; /* Тот же цвет, что у topBar */
    border: none;
    border-top: 1px solid #3A2F26; /* Полоска сверху */
    border-radius: 0;
}

/* Ссылки в нижней панели */
QPushButton#footerLink {
    background-color: transparent;
    color: #F5E6D3; /* Светлый кремовый, чтобы было видно */
    border: none;
    font-size: 13px;
    font-weight: normal;
    text-align: left;
    padding: 0px;
}
QPushButton#footerLink:hover {
    color: @accent@; /* Янтарный при наведении */
    text-decoration: underline;
}
QPushButton#footerLink:pressed {
    color: #D6932F;
}

/* ========================================================= */
/* === 12. SETTINGS WINDOW SIDEBAR ===                       */
/* ========================================================= */

#settingsSidebar {
    background-color: #141110; /* Чуть темнее контента, чтобы выделить панель */
    border-right: 1px solid #3A2F26;
}

#sidebarSectionTitle {
    color: #A8998A;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 1px;
    padding: 0px 12px;
    background: transparent;
}

#sidebarItem {
    background: transparent;
    color: #A8998A;
    border: 1px solid transparent;
    border-left: 3px solid transparent;
    border-radius: 4px;
    text-align: left;
    padding: 0px 15px;
    font-weight: normal;
    font-size: 13px;
}

#sidebarItem:hover {
    background: rgba(245, 230, 211, 0.04);
}

#sidebarItem:checked {
    color: @accent@;
    border: 1px solid @accent@;
    border-left: 3px solid @accent@;
    background: rgba(240, 169, 59, 0.08);
    font-weight: bold;
}

/* Имя пользователя внизу сайдбара */
#sidebarUsername {
    color: @accent@;
    font-size: 14px;
    font-weight: bold;
    padding-left: 15px;
}
