/* ========================================================= */
/* === ПАЛИТРА "РЖАВАЯ ЗОНА" ===                             */
/* ========================================================= */
/*   ФОН:           #181411 (основной)                       */
/*                  #1F1A16 (панели top/bottom)              */
/*                  #221C18 (кнопки/поля, hover)             */
/*   АКЦЕНТ:        @accent@ = #F0A93B (янтарный/ржавчина)   */
/*   ТЕКСТ:         #F5E6D3 (важный), #A8998A (обычный)      */
/*   РАМКИ:         #3A2F26                                  */
/*   ОПАСНОСТЬ:     #E5533D / #F07662 / #CC4730              */
/* ========================================================= */

/* ========================================================= */
/* === 1. ГЛОБАЛЬНЫЕ НАСТРОЙКИ ===                           */
/* ========================================================= */

QWidget {
    background-color: #181411;
    color: #A8998A;
    font-family: "IBM Plex Sans", "Segoe UI", Arial, sans-serif;
    font-size: 14px;
    font-weight: 400;
}

QLabel {
    background-color: transparent;
}

QDialog,
#loginDialog,
#registerDialog,
#requirementsPanel,
#settingsDialog {
    background: transparent;
    background-color: transparent;
}

QPushButton {
    background-color: @accent@;
    color: #181411;
    border: none;
    border-radius: 8px;
    padding: 0px 16px;
    font-weight: 700;
}
QPushButton:hover    { background-color: #F5BD6A; }
QPushButton:pressed  { background-color: #D6932F; }
QPushButton:disabled { background-color: #3A2F26; color: #A8998A; }

/* ========================================================= */
/* === 2. MAINWINDOW ===                                     */
/* ========================================================= */

#mainContainer {
    background-color: #181411;
    border: none;
    border-radius: 0;
}

#mainContainer #topBar {
    background-color: #1F1A16;
    border-bottom: 1px solid #3A2F26;
}

#mainContainer #bottomBar {
    background-color: #1F1A16;
    border-top: 1px solid #3A2F26;
}

#mainContainer #logoBtn {
    background: transparent;
    background-color: transparent;
    color: #F5E6D3;
    border: none;
    outline: none;
    border-radius: 0;
    font-size: 32px;
    font-weight: 700;
    text-align: left;
    padding: 0px 10px;
}
#mainContainer #logoBtn:hover,
#mainContainer #logoBtn:pressed,
#mainContainer #logoBtn:focus {
    background: transparent;
    background-color: transparent;
    color: #F5E6D3;
    border: none;
    outline: none;
}

#mainContainer #mainSidebar {
    background-color: #1F1A16;
    border-right: 1px solid #3A2F26;
}

#mainContainer #sidebarSectionTitle {
    color: #A8998A;
    font-size: 11px;
    font-weight: 600;
    margin-bottom: 4px;
}

#mainContainer #mainSidebar {
    background-color: #1F1A16;
    border-right: 1px solid #3A2F26;
}

#mainContainer #mainSidebarBtn {
    background-color: transparent;
    color: #A8998A;
    border: 1px solid transparent;
    border-left: 4px solid transparent;
    border-radius: 6px;
    text-align: left;
    padding-left: 7px;
    font-size: 14px;
    font-weight: 600;
}
#mainContainer #mainSidebarBtn:hover {
    background-color: rgba(245, 230, 211, 0.05);
    color: #F5E6D3;
    border-left: 4px solid transparent;
}
#mainContainer #mainSidebarBtn:checked {
    background-color: rgba(240, 169, 59, 0.05);
    color: @accent@;
    border: 1px solid @accent@;
    border-left: 4px solid @accent@;
}

#mainContainer #btnLogin {
    background-color: @accent@;
    color: #181411;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 700;
    text-align: center;
    padding-left: 15px;
    padding-right: 15px;
}
#mainContainer #btnLogin:hover   { background-color: #F5BD6A; }
#mainContainer #btnLogin:pressed { background-color: #D6932F; }

#mainContainer QToolButton#btnExit {
    background-color: #E5533D;
    border-radius: 8px;
}
#mainContainer QToolButton#btnExit:hover   { background-color: #F07662; }
#mainContainer QToolButton#btnExit:pressed { background-color: #CC4730; }

#mainContainer QToolButton#btnDiscord {
    background-color: #5865F2;
    border-radius: 8px;
}
#mainContainer QToolButton#btnDiscord:hover   { background-color: #7983F5; }
#mainContainer QToolButton#btnDiscord:pressed { background-color: #4752C4; }

/* ========================================================= */
/* === 3. AUCTION WINDOW ===                                 */
/* ========================================================= */

#auctionRoot {
    background-color: #181411;
}

#auctionRoot #topBar {
    background-color: #1F1A16;
    border-bottom: 1px solid #3A2F26;
}

#auctionRoot #logoBtn {
    background: transparent;
    color: #F5E6D3;
    border: none;
    outline: none;
    font-size: 32px;        /* было 40px */
    font-weight: 700;
    text-align: left;
    padding: 0px 15px;
    /* min-height: 60px; — убрано */
}
#auctionRoot #logoBtn:hover {
    background: transparent;
    color: #F5E6D3;
}

#auctionRoot #navBtn {
    background-color: transparent;
    color: #A8998A;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 0px 18px;
    font-weight: 600;
    font-size: 15px;
    text-align: center;
}
#auctionRoot #navBtn:hover {
    background-color: rgba(245, 230, 211, 0.05);
    color: #F5E6D3;
}
#auctionRoot #navBtn:checked {
    background-color: transparent;
    color: @accent@;
    border: 1px solid @accent@;
}

#auctionRoot #quickAccessSidebar {
    background-color: #1F1A16;
    border-right: 1px solid #3A2F26;
}
#auctionRoot #quickAccessTitle {
    color: #A8998A;
    font-size: 11px;
    font-weight: 600;
}

#auctionRoot #quickAccessBtn {
    background-color: transparent;
    color: #A8998A;
    border: 1px solid transparent;
    border-left: 4px solid transparent;
    border-radius: 6px;
    text-align: left;
    padding-left: 7px;
    padding-right: 48px;
    font-size: 14px;
    font-weight: 600;
}
#auctionRoot #quickAccessBtn:hover {
    background-color: transparent;
    color: #F5E6D3;
    border: 1px solid transparent;
    border-left: 4px solid transparent;
}
#auctionRoot #quickAccessBtn:checked {
    background-color: rgba(240, 169, 59, 0.05);
    color: @accent@;
    border: 1px solid @accent@;
    border-left: 4px solid @accent@;
}

#auctionRoot #categoryBtn {
    background-color: transparent;
    color: #A8998A;
    border: 1px solid transparent;
    border-left: 4px solid transparent;
    border-radius: 6px;
    text-align: left;
    padding-left: 7px;
    padding-right: 48px;
    font-size: 14px;
    font-weight: 600;
}
#auctionRoot #categoryBtn:hover {
    background-color: rgba(245, 230, 211, 0.05);
    color: #F5E6D3;
    border: 1px solid transparent;
    border-left: 4px solid transparent;
}
#auctionRoot #categoryBtn:checked {
    background-color: rgba(240, 169, 59, 0.05);
    color: @accent@;
    border: 1px solid @accent@;
    border-left: 4px solid @accent@;
}

#auctionRoot #rightTopBar {
    background-color: #181411;
    border-bottom: 1px solid #3A2F26;
}
#auctionRoot #searchEdit {
    background-color: #1F1A16;
    color: #F5E6D3;
    border: 1px solid #3A2F26;
    border-radius: 6px;
    padding-left: 10px;
    font-weight: 400;
}
#auctionRoot #filterBtn {
    background-color: transparent;
    color: #A8998A;
    border: 1px solid #3A2F26;
    border-radius: 6px;
    padding: 0px 12px;
    text-align: left;
    font-weight: 500;
}
#auctionRoot #filterBtn:hover {
    background-color: rgba(245, 230, 211, 0.05);
    color: #F5E6D3;
    border: 1px solid #4A3F36;
}

#auctionRoot #dropdownPopup {
    background-color: #1F1A16;
    border: 1px solid #3A2F26;
    border-radius: 8px;
}
#auctionRoot #dropdownItem {
    background-color: transparent;
    color: #A8998A;
    border: none;
    border-radius: 6px;
    text-align: left;
    padding: 0px 10px;
    font-size: 13px;
    font-weight: 500;
}
#auctionRoot #dropdownItem:hover {
    background-color: rgba(245, 230, 211, 0.05);
    color: #F5E6D3;
}

#auctionRoot #itemsList {
    background-color: transparent;
    border: none;
    outline: none;
    padding: 0px;
}
#auctionRoot #itemsList::item {
    background-color: transparent;
    border: none;
    padding: 0px;
}
#auctionRoot #itemsList::item:hover,
#auctionRoot #itemsList::item:selected {
    background-color: transparent;
    border: none;
}

#auctionRoot #itemCardIconContainer {
    background-color: #1F1A16;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border: none;
}
#auctionRoot #itemCardNameContainer {
    background-color: #181411;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border: none;
}
#auctionRoot #itemNameLabel {
    font-size: 11px;
    font-weight: 700;
    background: transparent;
}

#auctionRoot #bottomBar {
    background-color: #1F1A16;
    border-top: 1px solid #3A2F26;
}

/* Страница деталей предмета */
#auctionRoot #itemDetailRoot {
    background-color: #181411;
}

#auctionRoot #itemDetailName {
    font-size: 28px;
    font-weight: 700;
    background: transparent;
}

#auctionRoot #itemDetailSub {
    font-size: 16px;
    color: #A8998A;
    background: transparent;
}

#auctionRoot #itemDetailPrice {
    font-size: 20px;
    font-weight: 600;
    color: @accent@;
    background: transparent;
}

/* Карточка предмета в сайдбаре */
#auctionRoot #sidebarItemInfo {
    background-color: #1F1A16;
    border: 1px solid #3A2F26;
    border-radius: 12px;
}

#auctionRoot #sidebarItemName {
    color: #F5E6D3;
    font-size: 15px;
    font-weight: 700;
    background: transparent;
}

#auctionRoot #sidebarItemInfoLine {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    background: transparent;
}

/* Карточка статистики аукциона */
#auctionRoot #sidebarAuctionStats {
    background-color: #1F1A16;
    border: 1px solid #3A2F26;
    border-radius: 12px;
}

#auctionRoot #statTitle {
    color: #A8998A;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
    background: transparent;
}

#auctionRoot #statValue {
    color: #F5E6D3;
    font-size: 14px;
    font-weight: 700;
    background: transparent;
}

#auctionRoot #statDivider {
    background-color: #3A2F26;
    border: none;
    max-height: 1px;
}

#auctionRoot #enchantEdit {
    background-color: #221C18;
    color: #F5E6D3;
    border: 1px solid #3A2F26;
    border-radius: 4px;
    padding: 4px 6px;
    font-size: 12px;
}
#auctionRoot #enchantEdit:focus {
    border: 1px solid @accent@;
}

/* Горизонтальная панель фильтров */
#auctionRoot #filtersBar {
    background-color: #1F1A16;
    border: 1px solid #3A2F26;
    border-radius: 10px;
}

/* Панель "Лучшая цена" */
#auctionRoot #bestPricePanel {
    background-color: #1F1A16;
    border: 1px solid #3A2F26;
    border-radius: 10px;
}

#auctionRoot #bestPriceTitle {
    color: @accent@;
    font-size: 11px;
    font-weight: 600;
    background: transparent;
}

#auctionRoot #bestPriceValue {
    color: #F5E6D3;
    font-size: 16px;
    font-weight: 700;
    background: transparent;
}

/* ========================================================= */
/* === 4. SETTINGS WINDOW ===                                */
/* ========================================================= */

#settingsRoot {
    background-color: #181411;
}

#settingsRoot #topBar {
    background-color: #1F1A16;
    border-bottom: 1px solid #3A2F26;
}

#settingsRoot #logoBtn {
    background: transparent;
    color: #F5E6D3;
    border: none;
    outline: none;
    font-size: 32px;
    font-weight: 700;
    text-align: left;
    padding: 0px 10px;
}
#settingsRoot #logoBtn:hover {
    background: transparent;
    color: #F5E6D3;
}

#settingsRoot #settingsSidebar {
    background-color: #1F1A16;
    border-right: 1px solid #3A2F26;
}
#settingsRoot #sidebarSectionTitle {
    color: #A8998A;
    font-size: 11px;
    font-weight: 600;
    margin-bottom: 4px;
}
#settingsRoot #sidebarDivider {
    background-color: #3A2F26;
    margin: 0px 5px;
}
#settingsRoot #sidebarUsername {
    color: #F5E6D3;
    font-size: 13px;
    font-weight: 500;
}

#settingsRoot #settingsNavBtn {
    background-color: transparent;
    color: #A8998A;
    border: 1px solid transparent;
    border-left: 4px solid transparent;
    border-radius: 6px;
    text-align: left;
    padding-left: 7px;
    font-size: 14px;
    font-weight: 600;
}
#settingsRoot #settingsNavBtn:hover {
    background-color: rgba(245, 230, 211, 0.05);
    color: #F5E6D3;
    border-left: 4px solid transparent;
}
#settingsRoot #settingsNavBtn:checked {
    background-color: rgba(240, 169, 59, 0.05);
    color: @accent@;
    border: 1px solid @accent@;
    border-left: 4px solid @accent@;
}

#settingsRoot #contentHeaderPanel {
    background-color: #181411;
    border-bottom: 1px solid #3A2F26;
}
#settingsRoot #pageTitle {
    font-size: 16px;
    font-weight: 600;
    color: #F5E6D3;
}

#settingsRoot #profilePanel {
    background-color: #1F1A16;
    border: 1px solid #3A2F26;
    border-radius: 12px;
}
#settingsRoot #panelTitle {
    font-size: 15px;
    font-weight: 600;
    color: #F5E6D3;
}
#settingsRoot #panelSubtitle {
    font-size: 13px;
    font-weight: 600;
    color: #F5E6D3;
}
#settingsRoot #accountNameLabel {
    font-size: 18px;
    font-weight: 700;
    color: #F5E6D3;
}
#settingsRoot #accountDetailsLabel {
    font-size: 13px;
    color: #A8998A;
}
#settingsRoot #inputLabel {
    font-size: 11px;
    font-weight: 500;
    color: #A8998A;
}

/* === СПОСОБЫ ВХОДА === */
#settingsRoot #methodRow {
    background: transparent;
    background-color: transparent;
    border: none;
    border-radius: 6px;
}

#settingsRoot #methodTitle {
    font-size: 14px;
    font-weight: 500;
    color: #F5E6D3;
}
#settingsRoot #methodSubtitle {
    font-size: 12px;
    color: #A8998A;
}
#settingsRoot #bindingsLabel {
    font-size: 13px;
    color: #A8998A;
}

/* Бейджи статуса */
#settingsRoot #badgeActive {
    color: @accent@;
    background-color: transparent;
    border: 1px solid @accent@;
    border-radius: 4px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 600;
}
#settingsRoot #badgeInactive {
    color: #A8998A;
    background-color: transparent;
    border: 1px solid #3A2F26;
    border-radius: 4px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 600;
}

#settingsRoot #emailStatusLabel {
    background-color: #1F1A16;
    color: #E5533D;
    border: 1px solid #E5533D;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: bold;
}

#settingsRoot #dividerLine {
    background-color: #3A2F26;
    max-height: 1px;
    border: none;
}
#settingsRoot #accentButton {
    background-color: @accent@;
    color: #181411;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 700;
}
#settingsRoot #accentButton:hover   { background-color: #F5BD6A; }
#settingsRoot #accentButton:pressed { background-color: #D6932F; }

#settingsRoot #outlineButton {
    background-color: transparent;
    border: 1px solid @accent@;
    color: @accent@;
    border-radius: 6px;
    padding: 4px 15px;
    font-weight: 600;
    font-size: 12px;
}
#settingsRoot #outlineButton:hover {
    background-color: rgba(240, 169, 59, 0.1);
}

#settingsRoot #footerLink {
    background-color: transparent;
    color: @accent@;
    border: none;
    font-weight: 500;
    text-align: left;
    padding: 0;
}
#settingsRoot #footerLink:hover {
    text-decoration: underline;
    color: #F5BD6A;
}

#settingsRoot #btnDiscord {
    background-color: #5865F2;
    border: none;
    border-radius: 8px;
}
#settingsRoot #btnDiscord:hover { background-color: #7983F5; }

#settingsRoot QLineEdit {
    background-color: #221C18;
    color: #F5E6D3;
    border: 1px solid #3A2F26;
    border-radius: 6px;
    padding: 8px 12px;
    font-weight: 400;
}
#settingsRoot QLineEdit:focus {
    border: 1px solid @accent@;
}
#settingsRoot QLineEdit:read-only {
    background-color: #181411;
    color: #A8998A;
    border: 1px dashed #3A2F26;
}

/* Иконки "глазик" */
#settingsRoot QLineEdit QToolButton {
    background: transparent;
    border: none;
    padding: 0px;
    margin: 0px 5px 0px 0px;
}
#settingsRoot QLineEdit QToolButton:hover {
    background-color: rgba(245, 230, 211, 0.08);
    border-radius: 4px;
}

/* ========================================================= */
/* === 5. ДИАЛОГИ АВТОРИЗАЦИИ ===                            */
/* ========================================================= */

#dialogContainer {
    background-color: #1F1A16;
    border-radius: 15px;
    border: 1px solid #3A2F26;
}

#dialogContainer #loginTitle {
    font-size: 24px;
    font-weight: 600;
    color: #F5E6D3;
}
#dialogContainer #loginSubtitle {
    font-size: 14px;
    font-weight: 400;
    color: #A8998A;
}
#dialogContainer #inputLabel {
    font-size: 12px;
    font-weight: 500;
    color: #A8998A;
}

#dialogContainer #dividerLine {
    background-color: #3A2F26;
    max-height: 1px;
    border: none;
    margin: 5px 0;
}

#dialogContainer #linkButton {
    background: transparent;
    color: @accent@;
    font-size: 12px;
    font-weight: 500;
    border: none;
    text-align: right;
}
#dialogContainer #linkButton:hover {
    color: #F5BD6A;
    text-decoration: underline;
}

#dialogContainer #loginSubmitBtn {
    background-color: @accent@;
    color: #181411;
    font-weight: 700;
    font-size: 16px;
    border-radius: 8px;
}
#dialogContainer #loginSubmitBtn:hover   { background-color: #F5BD6A; }
#dialogContainer #loginSubmitBtn:pressed { background-color: #D6932F; }

#dialogContainer #outlineButton {
    background-color: transparent;
    border: 1px solid @accent@;
    color: @accent@;
    border-radius: 6px;
    padding: 4px 15px;
    font-weight: 600;
    font-size: 12px;
}
#dialogContainer #outlineButton:hover   { background-color: rgba(240, 169, 59, 0.1); }
#dialogContainer #outlineButton:pressed { background-color: rgba(240, 169, 59, 0.2); }

#dialogContainer QLineEdit {
    background-color: #221C18;
    color: #F5E6D3;
    border: 1px solid #3A2F26;
    border-radius: 6px;
    padding: 8px;
    font-weight: 400;
}
#dialogContainer QLineEdit:focus {
    border: 1px solid @accent@;
}

#dialogContainer QLineEdit QToolButton {
    background: transparent;
    border: none;
    padding: 0px;
    margin: 0px 5px 0px 0px;
}
#dialogContainer QLineEdit QToolButton:hover {
    background-color: rgba(245, 230, 211, 0.08);
    border-radius: 4px;
}

#dialogContainer QCheckBox {
    background: transparent;
    color: #A8998A;
    font-size: 13px;
    font-weight: 400;
    spacing: 8px;
}
#dialogContainer QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #3A2F26;
    border-radius: 4px;
    background-color: #221C18;
}
#dialogContainer QCheckBox::indicator:hover {
    border: 1px solid @accent@;
}
#dialogContainer QCheckBox::indicator:checked {
    background-color: #221C18;
    border: 1px solid @accent@;
    image: url("@rememberMeIcon@");
}

/* ========================================================= */
/* === 6. ОБЩИЕ ЭЛЕМЕНТЫ ===                                 */
/* ========================================================= */

#toastError {
    background-color: #1F1A16;
    color: #E5533D;
    border: 1px solid #E5533D;
    border-radius: 8px;
    padding: 12px 24px;
    font-weight: 700;
    font-size: 13px;
}
#toastSuccess {
    background-color: #1F1A16;
    color: @accent@;
    border: 1px solid @accent@;
    border-radius: 8px;
    padding: 12px 24px;
    font-weight: 700;
    font-size: 13px;
}

#requirementsContainer {
    background-color: #1F1A16;
    border: 1px solid #3A2F26;
    border-radius: 12px;
}
#rulesTitle {
    color: #F5E6D3;
    font-size: 13px;
    font-weight: 600;
}

#profileMenu {
    background-color: #1F1A16;
    border: 1px solid #3A2F26;
    border-radius: 10px;
}
#profileMenuItem {
    background-color: transparent;
    color: #A8998A;
    border: none;
    border-radius: 6px;
    text-align: left;
    padding: 0px 14px;
    font-size: 13px;
    font-weight: 500;
}
#profileMenuItem:hover {
    background-color: #221C18;
    color: @accent@;
}

#cardFavoriteBtn {
    background: transparent;
    border: none;
    padding: 0px;
    border-radius: 14px;
}
#cardFavoriteBtn:hover {
    background: rgba(240, 169, 59, 0.15);
}
#cardFavoriteBtn:pressed {
    background: rgba(240, 169, 59, 0.25);
}

#auctionRoot #sidebarCounter {
    background-color: #14100D;
    color: #A8998A;
    border: 1px solid #3A2F26;
    border-radius: 4px;
    padding: 0px 6px;
    font-size: 11px;
    font-weight: 600;
}
