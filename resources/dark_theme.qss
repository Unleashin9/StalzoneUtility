/* ========================================================= */
/* === 1. ПАЛИТРА (справочник) ===                           */
/* ========================================================= */
/*   ФОН:           #1E1E1E (основной), #252525 (alternate), */
/*                  #2D2D2D (поля/карточки), #333333 (hover) */
/*   ТЕКСТ:         #FFFFFF, #9CA3AF, #4B5563 (рамки)        */
/*   АКЦЕНТ:        @accent@ (из ThemeManager)               */
/*   ОПАСНОСТЬ:     #F87171 / #FCA5A5 / #EF4444              */
/*   BRANDS:        #5865F2 / #7983F5 / #4752C4 (Discord)    */
/* ========================================================= */

/* ========================================================= */
/* === 2. ГЛОБАЛЬНЫЕ НАСТРОЙКИ ===                           */
/* ========================================================= */

QWidget {
    background-color: #1E1E1E;
    color: #FFFFFF;
    font-family: "IBM Plex Sans", "Segoe UI", Arial, sans-serif;
    font-size: 14px;
}

QLabel {
    background-color: transparent;
}

QMainWindow, QDialog {
    background-color: transparent;
}

/* Базовая кнопка (fallback) */
QPushButton {
    background-color: @accent@;
    color: #000000;
    border: none;
    border-radius: 8px;
    padding: 0px 16px;
    font-weight: bold;
}
QPushButton:hover    { background-color: #BEF264; }
QPushButton:pressed  { background-color: #84CC16; }
QPushButton:disabled {
    background-color: #4B5563;
    color: #9CA3AF;
}

/* ========================================================= */
/* === 3. MAINWINDOW ===                                     */
/* ========================================================= */

#mainContainer {
    background-color: #1E1E1E;
    border: none;
    border-radius: 0px;
}

/* Логотип-кнопка (левый верхний угол) — АБСОЛЮТНО СТАТИЧНАЯ */
#logoBtn {
    background: transparent;
    background-color: transparent;
    color: #FFFFFF;
    border: none;
    outline: none;
    border-radius: 0;
    font-size: 22px;
    font-weight: bold;
    text-align: left;
    padding: 6px 12px 6px 8px;
    min-height: 44px;
}
#logoBtn:hover,
#logoBtn:pressed,
#logoBtn:focus,
#logoBtn:default {
    background: transparent;
    background-color: transparent;
    color: #FFFFFF;
    border: none;
    outline: none;
}

#appTitle {
    font-size: 32pt;
    font-weight: bold;
    color: @accent@;
}
#appSubtitle {
    font-size: 18pt;
    color: #FFFFFF;
}

/* Кнопка входа/профиля */
#btnLogin {
    background-color: @accent@;
    color: #000000;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: bold;
    text-align: center;
    padding-left: 15px;
    padding-right: 15px;
}
#btnLogin:hover   { background-color: #BEF264; }
#btnLogin:pressed { background-color: #84CC16; }

/* Кнопки-иконки */
QToolButton#btnExit, QToolButton#btnDiscord {
    border: none;
    border-radius: 8px;
    padding: 0px;
}
QToolButton#btnExit {
    background-color: #F87171;
}
QToolButton#btnExit:hover   { background-color: #FCA5A5; }
QToolButton#btnExit:pressed { background-color: #EF4444; }

QToolButton#btnDiscord {
    background-color: #5865F2;
}
QToolButton#btnDiscord:hover   { background-color: #7983F5; }
QToolButton#btnDiscord:pressed { background-color: #4752C4; }

/* Карточки на главном экране */
QPushButton#btnAuctionCard,
QPushButton#btnBarterCard,
QPushButton#btnItemsCard {
    background-color: #2D2D2D;
    color: #FFFFFF;
    border: 2px solid #4B5563;
    border-radius: 12px;
    font-size: 16px;
    font-weight: bold;
    padding: 15px;
    padding-top: 20px;
}
QPushButton#btnAuctionCard:hover,
QPushButton#btnBarterCard:hover,
QPushButton#btnItemsCard:hover {
    border: 2px solid @accent@;
    background-color: #333333;
}

/* ========================================================= */
/* === 4. ДИАЛОГИ АВТОРИЗАЦИИ (LOGIN / REGISTER) ===         */
/* ========================================================= */

#dialogContainer {
    background-color: #1E1E1E;
    border-radius: 15px;
    border: 1px solid #4B5563;
}

#dialogContainer #loginTitle {
    font-size: 24px;
    font-weight: bold;
    color: #FFFFFF;
}
#dialogContainer #loginSubtitle {
    font-size: 14px;
    color: #9CA3AF;
}

#dialogContainer #inputLabel {
    font-size: 12px;
    font-weight: bold;
    color: #9CA3AF;
}

#dialogContainer #dividerLine {
    color: #333333;
    background-color: #333333;
    max-height: 1px;
    border: none;
    margin-top: 5px;
    margin-bottom: 5px;
}

#dialogContainer #linkButton {
    background-color: transparent;
    color: @accent@;
    font-size: 12px;
    font-weight: normal;
    border: none;
    padding: 0px;
    text-align: right;
}
#dialogContainer #linkButton:hover {
    color: #BEF264;
    text-decoration: underline;
}

#dialogContainer #loginSubmitBtn {
    background-color: @accent@;
    color: #000000;
    font-weight: bold;
    font-size: 16px;
    border-radius: 8px;
}
#dialogContainer #loginSubmitBtn:hover   { background-color: #BEF264; }
#dialogContainer #loginSubmitBtn:pressed { background-color: #84CC16; }

#dialogContainer #outlineButton {
    background-color: transparent;
    border: 1px solid @accent@;
    color: @accent@;
    border-radius: 6px;
    padding: 4px 15px;
    font-weight: bold;
    font-size: 12px;
}
#dialogContainer #outlineButton:hover   { background-color: rgba(163, 230, 53, 0.1); }
#dialogContainer #outlineButton:pressed { background-color: rgba(163, 230, 53, 0.2); }

#dialogContainer QLineEdit {
    background-color: #2D2D2D;
    color: #FFFFFF;
    border: 1px solid #4B5563;
    border-radius: 6px;
    padding: 8px;
}
#dialogContainer QLineEdit:focus {
    border: 1px solid @accent@;
}

#dialogContainer QLineEdit QToolButton {
    background-color: transparent;
    border: none;
    padding: 0px;
    margin: 0px 5px 0px 0px;
}
#dialogContainer QLineEdit QToolButton:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
}

#dialogContainer QCheckBox {
    color: #FFFFFF;
    font-size: 13px;
    spacing: 8px;
}
#dialogContainer QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #4B5563;
    border-radius: 4px;
    background-color: transparent;
}
#dialogContainer QCheckBox::indicator:hover {
    border: 1px solid @accent@;
}
#dialogContainer QCheckBox::indicator:checked {
    background-color: transparent;
    border: 1px solid #4B5563;
    image: url("@rememberMeIcon@");
}

/* ========================================================= */
/* === 5. ОБЩИЕ ЭЛЕМЕНТЫ ===                                 */
/* ========================================================= */

#auctionRoot, #barterRoot, #itemsRoot {
    background-color: #1E1E1E;
}

QPushButton#btnBack {
    background-color: transparent;
    color: #9CA3AF;
    border: none;
    font-size: 16px;
    font-weight: normal;
    text-align: left;
    padding: 5px;
}
QPushButton#btnBack:hover {
    color: @accent@;
}

QTableWidget {
    background-color: #1E1E1E;
    alternate-background-color: #252525;
    gridline-color: transparent;
    border: none;
    border-radius: 0;
    selection-background-color: rgba(163, 230, 53, 0.25);
    selection-color: #FFFFFF;
    outline: none;
}
QTableWidget::item {
    padding: 6px 10px;
    border: none;
}

QHeaderView::section {
    background-color: #2D2D2D;
    color: #9CA3AF;
    font-size: 12px;
    font-weight: bold;
    padding: 8px 10px;
    border: none;
    border-bottom: 1px solid #4B5563;
}

QComboBox, QLineEdit {
    background-color: #2D2D2D;
    color: #FFFFFF;
    border: 1px solid #4B5563;
    border-radius: 6px;
    padding: 8px 12px;
    min-width: 150px;
}
QComboBox:focus, QLineEdit:focus {
    border: 1px solid @accent@;
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #4B5563;
    border-radius: 5px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: @accent@;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

/* ========================================================= */
/* === 6. УВЕДОМЛЕНИЯ (TOAST) ===                            */
/* ========================================================= */

#toastError {
    background-color: rgba(45, 45, 45, 0.95);
    color: #F87171;
    border: 1px solid #F87171;
    border-radius: 8px;
    padding: 12px 24px;
    font-weight: bold;
    font-size: 13px;
}
#toastSuccess {
    background-color: rgba(45, 45, 45, 0.95);
    color: @accent@;
    border: 1px solid @accent@;
    border-radius: 8px;
    padding: 12px 24px;
    font-weight: bold;
    font-size: 13px;
}

/* ========================================================= */
/* === 7. ПАНЕЛЬ ТРЕБОВАНИЙ ===                              */
/* ========================================================= */

#requirementsContainer {
    background-color: #1A1A1A;
    border: 1px solid #4B5563;
    border-radius: 12px;
}

#rulesTitle {
    color: #FFFFFF;
    font-size: 13px;
    font-weight: bold;
}

/* ========================================================= */
/* === 8. МЕНЮ ПРОФИЛЯ ===                                   */
/* ========================================================= */

#profileMenu {
    background-color: #252525;
    border: 1px solid #4B5563;
    border-radius: 10px;
}

#profileMenuItem {
    background-color: transparent;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    text-align: left;
    padding: 0px 14px;
    font-size: 13px;
    font-weight: normal;
}
#profileMenuItem:hover {
    background-color: #333333;
    color: @accent@;
}
#profileMenuItem:pressed {
    background-color: #2D2D2D;
}
