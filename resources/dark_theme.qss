/* ========================================================= */
/* === ПАЛИТРА "РЖАВАЯ ЗОНА" ===                             */
/* ========================================================= */
/*   ФОН:           #181411 (основной)                       */
/*                  #1F1A16 (панели top/bottom)              */
/*                  #221C18 (кнопки/поля, hover)             */
/*   АКЦЕНТ:        @accent@ = #F0A93B (янтарный/ржавчина)   */
/*   ТЕКСТ:         #F5E6D3 (важный), #A8998A (обычный)      */
/*   РАМКИ:         #3A2F26                                  */
/*   ОПАСНОСТЬ:     #E5533D / #F07662 / #CC4730              */
/*                                                           */
/*   ТИПОГРАФИКА (IBM Plex Sans):                            */
/*     400 = Regular     500 = Medium                        */
/*     600 = SemiBold    700 = Bold                          */
/* ========================================================= */

/* ========================================================= */
/* === 1. ГЛОБАЛЬНЫЕ НАСТРОЙКИ ===                           */
/* ========================================================= */

QWidget {
    background-color: #181411;
    color: #A8998A;
    font-family: "IBM Plex Sans", "Segoe UI", Arial, sans-serif;
    font-size: 14px;
    font-weight: 400;  /* Regular по умолчанию */
}

QLabel {
    background-color: transparent;
    font-weight: 400;
}

QDialog,
#loginDialog,
#registerDialog,
#requirementsPanel,
#settingsDialog {
    background: transparent;
    background-color: transparent;
}

QPushButton {
    background-color: @accent@;
    color: #181411;
    border: none;
    border-radius: 8px;
    padding: 0px 16px;
    font-weight: 700;  /* Bold */
}
QPushButton:hover    { background-color: #F5BD6A; }
QPushButton:pressed  { background-color: #D6932F; }
QPushButton:disabled {
    background-color: #3A2F26;
    color: #A8998A;
}

/* ========================================================= */
/* === 2. MAINWINDOW / TOP BAR ===                           */
/* ========================================================= */

#mainContainer {
    background-color: #181411;
    border: none;
    border-radius: 0;
}

#topBar {
    background-color: #1F1A16;
    border: none;
    border-bottom: 1px solid #3A2F26;
    border-radius: 0;
}

#logoBtn {
    background: transparent;
    background-color: transparent;
    color: #F5E6D3;
    border: none;
    outline: none;
    border-radius: 0;
    font-size: 40px;
    font-weight: 700;  /* Bold */
    text-align: left;
    padding: 0px 10px;
    min-height: 60px;
}
#logoBtn:hover,
#logoBtn:pressed,
#logoBtn:focus,
#logoBtn:default {
    background: transparent;
    background-color: transparent;
    color: #F5E6D3;
    border: none;
    outline: none;
}

#appTitle {
    font-size: 32pt;
    font-weight: 600;  /* SemiBold */
    color: @accent@;
}
#appSubtitle {
    font-size: 18pt;
    font-weight: 400;  /* Regular */
    color: #FFFFFF;
}

#btnLogin {
    background-color: @accent@;
    color: #181411;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 700;  /* Bold */
    text-align: center;
    padding-left: 15px;
    padding-right: 15px;
}
#btnLogin:hover   { background-color: #F5BD6A; }
#btnLogin:pressed { background-color: #D6932F; }

QToolButton#btnExit,
QToolButton#btnDiscord {
    border: none;
    border-radius: 8px;
    padding: 0px;
}

QToolButton#btnExit { background-color: #E5533D; }
QToolButton#btnExit:hover   { background-color: #F07662; }
QToolButton#btnExit:pressed { background-color: #CC4730; }

QToolButton#btnDiscord { background-color: #5865F2; }
QToolButton#btnDiscord:hover   { background-color: #7983F5; }
QToolButton#btnDiscord:pressed { background-color: #4752C4; }

/* ========================================================= */
/* === 3. ДИАЛОГИ АВТОРИЗАЦИИ (LOGIN / REGISTER) ===         */
/* ========================================================= */

#dialogContainer {
    background-color: #1F1A16;
    border-radius: 15px;
    border: 1px solid #3A2F26;
}

#dialogContainer #loginTitle {
    font-size: 24px;
    font-weight: 600;  /* SemiBold */
    color: #F5E6D3;
}
#dialogContainer #loginSubtitle {
    font-size: 14px;
    font-weight: 400;  /* Regular */
    color: #A8998A;
}

#dialogContainer #inputLabel {
    font-size: 12px;
    font-weight: 500;  /* Medium */
    color: #A8998A;
}

#dialogContainer #dividerLine {
    color: #3A2F26;
    background-color: #3A2F26;
    max-height: 1px;
    border: none;
    margin-top: 5px;
    margin-bottom: 5px;
}

#dialogContainer #linkButton {
    background-color: transparent;
    color: @accent@;
    font-size: 12px;
    font-weight: 500;  /* Medium */
    border: none;
    padding: 0px;
    text-align: right;
}
#dialogContainer #linkButton:hover {
    color: #F5BD6A;
    text-decoration: underline;
}

#dialogContainer #loginSubmitBtn {
    background-color: @accent@;
    color: #181411;
    font-weight: 700;  /* Bold */
    font-size: 16px;
    border-radius: 8px;
}
#dialogContainer #loginSubmitBtn:hover   { background-color: #F5BD6A; }
#dialogContainer #loginSubmitBtn:pressed { background-color: #D6932F; }

#dialogContainer #outlineButton {
    background-color: transparent;
    border: 1px solid @accent@;
    color: @accent@;
    border-radius: 6px;
    padding: 4px 15px;
    font-weight: 600;  /* SemiBold */
    font-size: 12px;
}
#dialogContainer #outlineButton:hover   { background-color: rgba(240, 169, 59, 0.1); }
#dialogContainer #outlineButton:pressed { background-color: rgba(240, 169, 59, 0.2); }

#dialogContainer QLineEdit {
    background-color: #221C18;
    color: #F5E6D3;
    border: 1px solid #3A2F26;
    border-radius: 6px;
    padding: 8px;
    font-weight: 400;  /* Regular */
}
#dialogContainer QLineEdit:focus {
    border: 1px solid @accent@;
}

#dialogContainer QLineEdit QToolButton {
    background-color: transparent;
    border: none;
    padding: 0px;
    margin: 0px 5px 0px 0px;
}
#dialogContainer QLineEdit QToolButton:hover {
    background-color: rgba(245, 230, 211, 0.08);
    border-radius: 4px;
}

#dialogContainer QCheckBox {
    background: transparent;
    background-color: transparent;
    color: #A8998A;
    font-size: 13px;
    font-weight: 400;  /* Regular */
    spacing: 8px;
}
#dialogContainer QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #3A2F26;
    border-radius: 4px;
    background-color: #221C18;
}
#dialogContainer QCheckBox::indicator:hover   { border: 1px solid @accent@; }
#dialogContainer QCheckBox::indicator:checked {
    background-color: #221C18;
    border: 1px solid @accent@;
    image: url("@rememberMeIcon@");
}

/* ========================================================= */
/* === 4. ОБЩИЕ ЭЛЕМЕНТЫ (ТАБЛИЦЫ, ПОЛЯ, СКРОЛЛ) ===        */
/* ========================================================= */

#auctionRoot, #barterRoot, #itemsRoot, #settingsRoot {
    background-color: #181411;
}

QPushButton#btnBack {
    background-color: transparent;
    color: #A8998A;
    border: none;
    font-size: 16px;
    font-weight: 500;  /* Medium */
    text-align: left;
    padding: 5px;
}
QPushButton#btnBack:hover {
    color: @accent@;
}

QTableWidget {
    background-color: #181411;
    alternate-background-color: #1F1A16;
    gridline-color: transparent;
    border: none;
    border-radius: 0;
    selection-background-color: rgba(240, 169, 59, 0.25);
    selection-color: #F5E6D3;
    outline: none;
}
QTableWidget::item {
    padding: 6px 10px;
    border: none;
}

QHeaderView::section {
    background-color: #1F1A16;
    color: #A8998A;
    font-size: 12px;
    font-weight: 600;  /* SemiBold */
    padding: 8px 10px;
    border: none;
    border-bottom: 1px solid #3A2F26;
}

QComboBox, QLineEdit {
    background-color: #221C18;
    color: #F5E6D3;
    border: 1px solid #3A2F26;
    border-radius: 6px;
    padding: 8px 12px;
    min-width: 150px;
    font-weight: 400;  /* Regular */
}
QComboBox:focus, QLineEdit:focus {
    border: 1px solid @accent@;
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #3A2F26;
    border-radius: 5px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover { background: @accent@; }
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0; }

/* ========================================================= */
/* === 5. УВЕДОМЛЕНИЯ (TOAST) ===                            */
/* ========================================================= */

#toastError {
    background-color: #1F1A16;
    color: #E5533D;
    border: 1px solid #E5533D;
    border-radius: 8px;
    padding: 12px 24px;
    font-weight: 700;  /* Bold */
    font-size: 13px;
}
#toastSuccess {
    background-color: #1F1A16;
    color: @accent@;
    border: 1px solid @accent@;
    border-radius: 8px;
    padding: 12px 24px;
    font-weight: 700;  /* Bold */
    font-size: 13px;
}

/* ========================================================= */
/* === 6. ПАНЕЛЬ ТРЕБОВАНИЙ ===                              */
/* ========================================================= */

#requirementsContainer {
    background-color: #1F1A16;
    border: 1px solid #3A2F26;
    border-radius: 12px;
}

#rulesTitle {
    color: #F5E6D3;
    font-size: 13px;
    font-weight: 600;  /* SemiBold */
}

/* ========================================================= */
/* === 7. МЕНЮ ПРОФИЛЯ ===                                   */
/* ========================================================= */

#profileMenu {
    background-color: #1F1A16;
    border: 1px solid #3A2F26;
    border-radius: 10px;
}

#profileMenuItem {
    background-color: transparent;
    color: #A8998A;
    border: none;
    border-radius: 6px;
    text-align: left;
    padding: 0px 14px;
    font-size: 13px;
    font-weight: 500;  /* Medium */
}
#profileMenuItem:hover   { background-color: #221C18; color: @accent@; }
#profileMenuItem:pressed { background-color: #181411; }

/* ========================================================= */
/* === 8. AUCTION WINDOW ===                                 */
/* ========================================================= */

#auctionContent {
    background-color: #181411;
}

#navBtn {
    background-color: transparent;
    color: #A8998A;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 0px 18px;
    font-weight: 600;  /* SemiBold */
    font-size: 15px;
    text-align: center;
}
#navBtn:hover   { background-color: rgba(245, 230, 211, 0.05); color: #F5E6D3; }
#navBtn:checked { background-color: transparent; color: @accent@; border: 1px solid @accent@; }

#quickAccessSidebar {
    background-color: #1F1A16;
    border-right: 1px solid #3A2F26;
}

#quickAccessTitle {
    color: #A8998A;
    font-size: 11px;
    font-weight: 600;  /* SemiBold */
}

#quickAccessBtn {
    background-color: transparent;
    color: #A8998A;
    border: 1px solid transparent;
    border-left: 4px solid transparent;
    border-radius: 6px;
    text-align: left;
    padding-left: 7px;
    font-size: 14px;
    font-weight: 600;  /* SemiBold */
}
#quickAccessBtn:hover {
    background-color: transparent; /* <--- УБРАЛИ ЦВЕТ ПРИ НАВЕДЕНИИ */
    color: #F5E6D3;
    border: 1px solid transparent;
    border-left: 4px solid transparent;
}
#quickAccessBtn:checked {
    background-color: rgba(240, 169, 59, 0.05);
    color: @accent@;
    border: 1px solid @accent@;
    border-left: 4px solid @accent@;
}

#categoryBtn {
    background-color: transparent;
    color: #A8998A;
    border: 1px solid transparent;
    border-left: 4px solid transparent;
    border-radius: 6px;
    text-align: left;
    padding-left: 7px;
    font-size: 14px;
    font-weight: 600;  /* SemiBold */
}
#categoryBtn:hover {
    background-color: rgba(245, 230, 211, 0.05);
    color: #F5E6D3;
    border: 1px solid transparent;
    border-left: 4px solid transparent;
}
#categoryBtn:checked {
    background-color: rgba(240, 169, 59, 0.05);
    color: @accent@;
    border: 1px solid @accent@;
    border-left: 4px solid @accent@;
}

#rightTopBar {
    background-color: #181411;
    border-bottom: 1px solid #3A2F26;
}

#searchEdit {
    background-color: #1F1A16;
    color: #F5E6D3;
    border: 1px solid #3A2F26;
    border-radius: 6px;
    padding-left: 10px;
    font-weight: 400;  /* Regular */
}

#filterBtn {
    background-color: transparent;
    color: #A8998A;
    border: 1px solid #3A2F26;
    border-radius: 6px;
    padding: 0px 12px;
    text-align: left;
    font-weight: 500;  /* Medium */
}
#filterBtn:hover {
    background-color: rgba(245, 230, 211, 0.05);
    color: #F5E6D3;
    border: 1px solid #4A3F36;
}

#dropdownPopup {
    background-color: #1F1A16;
    border: 1px solid #3A2F26;
    border-radius: 8px;
}
#dropdownItem {
    background-color: transparent;
    color: #A8998A;
    border: none;
    border-radius: 6px;
    text-align: left;
    padding: 0px 10px;
    font-size: 13px;
    font-weight: 500;  /* Medium */
}
#dropdownItem:hover { background-color: rgba(245, 230, 211, 0.05); color: #F5E6D3; }

/* === Список предметов (плитки) === */
#itemsList {
    background-color: transparent;
    border: none;
    outline: none;
    padding: 0px;
}
#itemsList::item {
    background-color: transparent;
    border: none;
    padding: 0px;
}
#itemsList::item:hover,
#itemsList::item:selected {
    background-color: transparent;
    border: none;
}

/* === Карточки предметов === */
#itemCardIconContainer {
    background-color: #1F1A16;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border: none;
}
#itemCardNameContainer {
    background-color: #181411;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border: none;
}

/* === Кнопка избранного на карточке === */
#cardFavoriteBtn {
    background: transparent;
    background-color: transparent;
    border: none;
    padding: 0px;
    border-radius: 14px;
}
#cardFavoriteBtn:hover {
    background: rgba(240, 169, 59, 0.15); /* Легкая подсветка при наведении */
}
#cardFavoriteBtn:pressed {
    background: rgba(240, 169, 59, 0.25);
}

/* Название предмета — жирное, размер 11px. Цвет приходит из кода (динамический) */
#itemNameLabel {
    font-size: 11px;
    font-weight: 700;  /* Bold */
    background: transparent;
}

/* Нижняя панель */
#bottomBar {
    background-color: #1F1A16;
    border-top: 1px solid #3A2F26;
}

/* ========================================================= */
/* === 9. SETTINGS WINDOW ===                                */
/* ========================================================= */

#settingsRoot {
    background-color: #181411;
}
